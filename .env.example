# WhatsApp Business
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=

# Supabase (server-side only - never expose service role key to client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=

# Contact notifications
CONTACT_NOTIFICATION_EMAIL=

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=
PII_HASH_SECRET=

# Email sender
RESEND_FROM_EMAIL=VIABIL <no-reply@viabil.com.br>

# Admin / analytics
VERCEL_ANALYTICS_DRAIN_SECRET=

# Error monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional SMS escalation provider
ERROR_ALERT_EMAIL=
SENTRY_ALERT_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

# Site URL (SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.viabil.com.br
